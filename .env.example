# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://aihub:aihub_secret@localhost:5432/aihub?sslmode=disable

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Encryption (for provider tokens)
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Docker (for terminal sandbox)
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_IMAGE=aihub-sandbox:latest
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=0.5
